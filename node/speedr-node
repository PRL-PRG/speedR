#!/bin/bash
# speedR on a benchmark node: build an R implementation in the toolchain image
# (build/: housekeeping CPUs, no network), GNU R or another one (impls/, in
# its own image on top of it), then run the timing pass on it in the same
# image, or the profile pass in the profile image on top of it, pinned to the
# isolated CPU, with no network.
#
#   speedr-node image                         build the toolchain, profile and
#                                             implementations' images
#   speedr-node resolve SOURCE                its label: fetch it if need be
#   speedr-node env|id SOURCE                 the build settings | the build id
#   speedr-node configure SOURCE              configure only; print config.h
#   speedr-node build SOURCE                  build R (cached by build id) in $work/r/<id>
#   speedr-node sentinel                      the sentinel alone: does this box measure
#                                             as its machine should?
#   speedr-node run SOURCE [timing.py args]   sentinel, then the timing pass, one pass of
#                                             the suite per code layout ->
#                                             $work/results/LABEL/RUN_ID/, copied to
#                                             the controller's spool
#   speedr-node profile SOURCE [profile.py args]
#                                             the profile pass on the build as built,
#                                             reduced to category shares (categorize.R)
#                                             -> the same places
#
# The machine is $SPEEDR_MACHINE, by default the Slurm partition
# (machines/<name>.toml). SOURCE is a GNU R release (4.6.2), `devel` or
# `patched` (today's snapshot, kept as devel-r<svn revision>), such a label
# (devel-r90937), or a source tarball; or another implementation at a branch
# or commit, IMPL@REF (rcp@main), kept as IMPL-<commit, 12 digits>. How a GNU R
# version is built: build/settings.toml; another implementation:
# impls/<name>/. Data (sources, logs, results) goes to $SPEEDR_WORK
# (~/speedr-work); this checkout needs `uv sync` once.
set -euo pipefail
repo=$(cd "$(dirname "$0")/.." && pwd)
work=${SPEEDR_WORK:-$HOME/speedr-work}
image=speedr-toolchain
bench_cpus=3 housekeeping_cpus=0-2
# the code layouts every build is installed at (build/build-r.sh): bytes of
# filler in front of R's code, spread over a 4 KiB page (the period of the
# instruction cache's sets); the timing pass runs one process per benchmark on
# each (methodology 0.5)
layouts="0 1000 2100 3300"
prerelease=https://cloud.r-project.org/src/base-prerelease
cran=https://cloud.r-project.org/src/contrib
# the one package beyond R's recommended ones that the suite needs (lr, lr_test,
# pca and pca-blocked generate their input with it): every build gets the
# version that was on CRAN at the date of its source
extra_pkg=clusterGeneration
# results go to the controller's spool (speedr's key can only write there)
spool=speedr@prl-prg-bench-master:
# the node's probe result, written by the cluster's Slurm prolog before each job
probe=/run/prlprg-bench/probe.json
mkdir -p "$work/src" "$work/results" "$work/r"

# R as it runs (profile pass): perf records every benchmark; a recording is
# tens of MB, so once reduced to category shares they are deleted
profile_image=speedr-profile

# the speedr account is in the docker group; others go through sudo
docker() { if [ -w /var/run/docker.sock ]; then command docker "$@"; else sudo -n docker "$@"; fi; }

tarball_file() {  # TARBALL NAME -> first line of the top-level file NAME
    # (top-level only: R's sources have more files called VERSION)
    local m; m=$(tar --warning=no-unknown-keyword -tzf "$1" | awk -v n="$2" '$0 ~ "^[^/]+/" n "$" && !f { print; f = 1 }')
    [ -n "$m" ] || return 0
    tar --warning=no-unknown-keyword -xzOf "$1" "$m" | head -n 1
}

snapshot() {  # devel|patched -> label of today's snapshot, downloaded into src/
    local t rev; t=$(mktemp -p "$work/src")
    curl -fsSL -o "$t" "$prerelease/R-$1.tar.gz"
    rev=$(tarball_file "$t" SVN-REVISION | sed -n 's/^Revision: *//p')
    [ -n "$rev" ] || { rm -f "$t"; echo "no SVN-REVISION in R-$1.tar.gz" >&2; exit 1; }
    mv "$t" "$work/src/R-$1-r$rev.tar.gz"
    echo "$1-r$rev"
}

impl_of() {  # LABEL -> its implementation: <name> of <name>-<commit>, or gnur
    if [[ $1 =~ ^([a-z][a-z0-9]*)-[0-9a-f]{12}$ ]] && [ -f "$repo/impls/${BASH_REMATCH[1]}/impl.toml" ]; then
        echo "${BASH_REMATCH[1]}"
    else
        echo gnur
    fi
}

impl_settings() { "$repo/.venv/bin/speedr" impls "$1"; }   # NAME -> impl_repo=... (eval them)

tarball() {  # LABEL -> its source tarball
    if [ "$(impl_of "$1")" = gnur ]; then echo "$work/src/R-$1.tar.gz"; else echo "$work/src/$1.tar.gz"; fi
}

impl_source() {  # IMPL REF -> label IMPL-<commit>; the commit's source, with its
    # submodules and whatever its fetch.sh adds, in $work/src/<label>.tar.gz and
    # what it is in <label>.env
    local impl=$1 ref=$2 t commit label
    eval "$(impl_settings "$impl")"
    resolve "$impl_base" > /dev/null   # its base release's tarball (fetch.sh, extra package)
    t=$(mktemp -d -p "$work/src")
    git clone -q --filter=blob:none --no-checkout "$impl_repo" "$t/src"
    commit=$(git -C "$t/src" rev-parse --verify -q "origin/$ref^{commit}" ||
             git -C "$t/src" rev-parse --verify -q "$ref^{commit}") ||
        { rm -rf "$t"; echo "$impl: no branch or commit $ref in $impl_repo" >&2; exit 1; }
    label=$impl-${commit:0:12}
    if [ ! -s "$work/src/$label.tar.gz" ]; then
        git -C "$t/src" -c advice.detachedHead=false checkout -q "$commit"
        git -C "$t/src" submodule -q update --init --recursive --depth 1
        [ "$impl_fetch" = 0 ] || (cd "$t/src" && "$repo/impls/$impl/fetch.sh" "$(tarball "$impl_base")")
        {
            echo "impl=$impl"; echo "base=$impl_base"; echo "repo=$impl_repo"; echo "ref=$ref"
            echo "commit=$commit"; echo "commit_date=$(git -C "$t/src" log -1 --format=%cI "$commit")"
        } > "$t/source.env"
        tar -C "$t/src" --exclude=.git -czf "$t/source.tar.gz" .
        mv "$t/source.env" "$work/src/$label.env"
        mv "$t/source.tar.gz" "$work/src/$label.tar.gz"
    fi
    rm -rf "$t"
    echo "$label"
}

resolve() {  # SOURCE -> label; its tarball is then $(tarball <label>)
    local s=$1 label rev f
    case $s in
        *@*) impl_source "${s%%@*}" "${s#*@}"; return ;;
        devel|patched) snapshot "$s"; return ;;
        *.tar.gz)
            rev=$(tarball_file "$s" SVN-REVISION | sed -n 's/^Revision: *//p')
            label=$(tarball_file "$s" VERSION |
                awk '{ print ($2 == "Under") ? "devel" : ($2 == "Patched") ? "patched" : $1 }')
            case $label in devel|patched) label="$label-r$rev" ;; esac
            cp "$s" "$work/src/R-$label.tar.gz"; echo "$label"; return ;;
        devel-r*|patched-r*)
            if [ ! -s "$work/src/R-$s.tar.gz" ]; then   # still on CRAN?
                f=$(curl -fsSL "$prerelease/" | grep -o -E "R-${s%%-r*}_[0-9-]+_r${s##*-r}\\.tar\\.gz" | head -1)
                [ -n "$f" ] || { echo "no snapshot $s on CRAN any more" >&2; exit 1; }
                curl -fsSL -o "$work/src/R-$s.tar.gz" "$prerelease/$f"
            fi
            echo "$s"; return ;;
        *)
            if [ "$(impl_of "$s")" != gnur ]; then   # a label: fetched before
                [ -s "$work/src/$s.tar.gz" ] || { echo "no source $s: give it as IMPL@REF" >&2; exit 1; }
                echo "$s"; return
            fi
            [ -s "$work/src/R-$s.tar.gz" ] ||
                curl -fsSL -o "$work/src/R-$s.tar.gz" "https://cloud.r-project.org/src/base/R-${s%%.*}/R-$s.tar.gz"
            echo "$s" ;;
    esac
}

base_of() {  # LABEL -> the GNU R it is: itself, or its implementation's base release
    local impl; impl=$(impl_of "$1")
    if [ "$impl" = gnur ]; then echo "$1"; else sed -n 's/^base=//p' "$work/src/$1.env"; fi
}

source_version() { tarball_file "$work/src/R-$(base_of "$1").tar.gz" VERSION; }   # LABEL -> its VERSION line

source_date() {  # LABEL -> the date of its source: SVN-REVISION's Last Changed Date, or the commit's
    if [ "$(impl_of "$1")" != gnur ]; then sed -n 's/^commit_date=//p' "$work/src/$1.env"; return; fi
    tar --warning=no-unknown-keyword -xzOf "$work/src/R-$1.tar.gz" --wildcards '*/SVN-REVISION' | sed -n 's/^Last Changed Date: *//p' | head -1
}

extra_pkg_file() {  # LABEL -> the extra package's tarball current on CRAN at the date of its GNU R
    curl -fsSL "$cran/Archive/$extra_pkg/" "$cran/" |
        grep -o -E ">${extra_pkg}_[0-9.-]+\\.tar\\.gz</a> +[0-9-]+" | sed -E 's/^>//; s#</a> +# #' |
        awk -v d="$(source_date "$(base_of "$1")")" '$2 <= d' | sort -k2 | tail -1 | cut -d' ' -f1
}

flags_env() { "$repo/.venv/bin/speedr" build-env "$(source_version "$1")"; }

image_of() {  # LABEL -> the image it builds and runs in
    local impl; impl=$(impl_of "$1")
    if [ "$impl" != gnur ] && [ -f "$repo/impls/$impl/Dockerfile" ]; then echo "speedr-$impl"; else echo "$image"; fi
}

layouts_of() {  # LABEL -> the code layouts it is installed at (0 alone: R as built)
    local impl; impl=$(impl_of "$1")
    if [ "$impl" = gnur ] || { eval "$(impl_settings "$impl")"; [ "$impl_layouts" = 1 ]; }; then
        echo "$layouts"
    else
        echo 0
    fi
}

build_id() {  # LABEL -> id, from speedr.ids (source, settings, package, image; for
    # another implementation its commit and its impls/ recipe)
    local impl source recipe="" toolchain
    impl=$(impl_of "$1")
    if [ "$impl" = gnur ]; then
        source=$(sha256sum "$work/src/R-$1.tar.gz" | cut -d' ' -f1)
    else
        source=$(sed -n 's/^commit=//p' "$work/src/$1.env")
        recipe=$(cat "$repo/impls/$impl"/*.sh "$repo/build/build-impl.sh" "$repo/build/layouts.sh" | sha256sum | cut -c1-16)
    fi
    toolchain=$(docker image inspect --format '{{.Id}}' "$(image_of "$1")")
    flags_env "$1" | "$repo/.venv/bin/python" -c '
import sys
from speedr.ids import build_id
impl, source, toolchain, package, layouts, recipe = sys.argv[1:]
flags = dict(line.rstrip("\n").split("=", 1) for line in sys.stdin)
flags["configure"] = "R defaults (./configure --prefix only)"
flags["packages"] = package
flags["layouts"] = layouts
if recipe:
    flags["recipe"] = recipe
print(build_id(impl, source, "default", flags, toolchain))' \
        "$impl" "$source" "$toolchain" "$(extra_pkg_file "$1")" "$(layouts_of "$1")" "$recipe"
}

in_image() {  # LABEL ARGS... -> its build script with ARGS in its image, with its settings:
    # GNU R: build/build-r.sh TARBALL ARGS; another: build/build-impl.sh IMPL TARBALL ARGS
    local l=$1 impl; shift
    impl=$(impl_of "$l")
    flags_env "$l" > "$work/flags-$l.env"
    docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp --cpuset-cpus "$housekeeping_cpus" \
        --network none --tmpfs /build:exec,mode=1777,size=8g --env-file "$work/flags-$l.env" \
        -e SPEEDR_LAYOUTS="$(layouts_of "$l")" -e SPEEDR_SOURCE_DATE="$(source_date "$l")" \
        -v "$repo:$repo:ro" -v "$work:$work" "$(image_of "$l")" \
        $(if [ "$impl" = gnur ]; then echo "$repo/build/build-r.sh"; else echo "$repo/build/build-impl.sh $impl"; fi) \
        "$(tarball "$l")" "$@"
}

# the container runs under dockerd, not this script: when Slurm cancels the job
# (SIGTERM), stop it too
name=""
trap '[ -n "$name" ] && docker kill "$name" >/dev/null 2>&1; exit 143' TERM INT

bench() {  # NAME timing|profile R ARGS... -> drivers/<pass>.py in its image, on the bench CPU
    # (timing: $bench_image, the image of the implementation measured)
    name=speedr-$1-$(date +%s)-$$; local pass=$2 r=$3 img=${bench_image:-$image}; shift 3
    [ "$pass" = timing ] || img=$profile_image
    # setup() caches inputs in the benchmarks' data/ folders, some per R
    # version (Matrix objects): start every pass without them
    find "$repo/.venv" -path '*/rbench/benchmarks/*/data' -prune -exec rm -rf {} +
    # seccomp=unconfined: docker's default profile refuses the personality
    # call `setarch -R` makes to switch ASLR off for R
    docker run --rm --name "$name" --user "$(id -u):$(id -g)" -e HOME=/tmp --network none \
        --cpuset-cpus "$bench_cpus" --cpuset-mems 0 --security-opt seccomp=unconfined \
        -v "$repo:$repo" -v "$work:$work" -w "$repo" "$img" \
        .venv/bin/python "drivers/$pass.py" --R "$r" --no-progress "$@" &
    local rc=0; wait $! || rc=$?   # in the background, so the trap runs as soon as the signal arrives
    return $rc
}

machine() {
    local m=${SPEEDR_MACHINE:-${SLURM_JOB_PARTITION:-}}
    [ -n "$m" ] || { echo "no machine: set SPEEDR_MACHINE (machines/<name>.toml)" >&2; exit 2; }
    echo "$m"
}

sentinel() {  # MACHINE DIR -> DIR/sentinel.json; exit status 3: failed
    local version include runs iterations warmups id rc=0
    eval "$("$repo/.venv/bin/speedr" sentinel --plan)"
    id=$(build_id "$(resolve "$version")")
    [ -x "$work/r/$id/bin/R" ] || "$0" build "$version" >&2
    bench sentinel timing "$work/r/$id/bin/R" --include "$include" --runs "$runs" --iterations "$iterations" \
        --warmups "$warmups" --json "$2/sentinel-timing.json" --dir "$2/sentinel-exec" >/dev/null || true
    "$repo/.venv/bin/speedr" sentinel "$2/sentinel-timing.json" "$1" > "$2/sentinel.json" || rc=$?
    echo "sentinel on $(hostname -s): $(tr -d '\n ' < "$2/sentinel.json" | grep -o '"deviation":[^,]*,"status":"[a-z]*"')"
    return $rc
}

start() {  # SOURCE -> sets l machine id run_id out started uptime: a new results directory
    l=$(resolve "$1")
    machine=$(machine)
    id=$(build_id "$l")
    [ -x "$work/r/$id/bin/R" ] || { echo "R $l: no build $id; run '$0 build $l' first"; exit 1; }
    run_id=$(date -u +%Y%m%dT%H%M%SZ)-$(openssl rand -hex 3)
    out=$work/results/$l/$run_id; mkdir -p "$out"
    cp "$work/r/$id/speedr-build.env" "$out/"
    [ -r "$probe" ] && cp "$probe" "$out/"
    started=$(date -u +%Y-%m-%dT%H:%M:%SZ) uptime=$(cut -d' ' -f1 /proc/uptime)
}

describe() {  # EXIT -> the lines of run.env every pass writes
    echo "run_id=$run_id"; echo "label=$l"; echo "machine=$machine"; echo "node=$(hostname -s)"
    echo "job=${SLURM_JOB_ID:-}"; echo "config=default"
    echo "methodology=$("$repo/.venv/bin/speedr" methodology --current)"
    echo "started=$started"; echo "finished=$(date -u +%Y-%m-%dT%H:%M:%SZ)"; echo "exit=$1"
    echo "kernel=$(uname -r)"; echo "cmdline=$(cat /proc/cmdline)"
    echo "os_release=$(. /etc/os-release && echo "$PRETTY_NAME")"
    echo "boot_id=$(cat /proc/sys/kernel/random/boot_id)"; echo "uptime_s=$uptime"
    echo "cpuset=$bench_cpus"
    echo "source_sha256=$(sha256sum "$work/src/R-$l.tar.gz" | cut -d' ' -f1)"
    echo "speedr=$(git -C "$repo" rev-parse HEAD)"
    "$repo/.venv/bin/speedr" suite | awk '{ print $1 "=" $2 }'
}

to_spool() {  # copy $out to the controller's spool, $out/run.env.new last as run.env
    # run.env last: the controller ingests a run once it has arrived
    rsync -aR --exclude run.env.new --exclude "/$l/$run_id/perf/" "$work/results/./$l/$run_id" "$spool" &&
        mv "$out/run.env.new" "$out/run.env" &&
        rsync -aR "$work/results/./$l/$run_id/run.env" "$spool" &&
        echo "results: $out, copied to the controller's spool"
}

cmd=${1:-}; shift || true
case $cmd in
image)
    docker build --cpuset-cpus "$housekeeping_cpus" -t "$image" "$repo/build"
    # perf as the node's kernel has it
    docker build --cpuset-cpus "$housekeeping_cpus" -t "$profile_image" -f "$repo/build/Dockerfile.profile" \
        --build-arg PERF="$(dpkg-query -W -f='${Version}' linux-perf)" "$repo/build"
    for d in "$repo"/impls/*/Dockerfile; do
        [ -e "$d" ] || continue
        docker build --cpuset-cpus "$housekeeping_cpus" -t "speedr-$(basename "$(dirname "$d")")" "$(dirname "$d")"
    done
    ;;
resolve)
    resolve "$1"
    ;;
env)
    l=$(resolve "$1"); echo "# R $l: $(source_version "$l"), $(source_date "$l"), $(extra_pkg_file "$l")"
    flags_env "$l"
    ;;
id)
    build_id "$(resolve "$1")"
    ;;
configure)
    l=$(resolve "$1")
    [ "$(impl_of "$l")" = gnur ] || { echo "configure is for GNU R sources only" >&2; exit 2; }
    in_image "$l" /tmp/unused configure
    ;;
build)
    l=$(resolve "$1")
    id=$(build_id "$l"); prefix=$work/r/$id
    if [ -x "$prefix/bin/R" ]; then echo "R $l: cached build $id"; exit 0; fi
    echo "R $l: building $id"
    pkg=$(extra_pkg_file "$l")
    [ -s "$work/src/$pkg" ] || curl -fsL -o "$work/src/$pkg" "$cran/$pkg" ||
        curl -fsSL -o "$work/src/$pkg" "$cran/Archive/$extra_pkg/$pkg"
    if [ "$(impl_of "$l")" = gnur ]; then
        in_image "$l" "$prefix" build "$work/src/$pkg"
    else
        in_image "$l" "$prefix" "$work/src/$pkg"
    fi > "$work/build-$l.log" 2>&1 ||
        { echo "R $l: build failed, see $work/build-$l.log"; rm -rf "$prefix"; exit 1; }
    {
        echo "source=$l"; echo "version=$(source_version "$l")"; echo "date=$(source_date "$l")"
        echo "id=$id"; echo "package=$pkg"
        if [ "$(impl_of "$l")" = gnur ]; then echo "configure=R defaults (./configure --prefix only)"
        else echo "configure=impls/$(impl_of "$l")/build.sh"; fi
        echo "toolchain=$(docker image inspect --format '{{.Id}}' "$(image_of "$l")")"
        cat "$work/flags-$l.env"
    } > "$prefix/speedr-build.env"
    echo "R $l: built $id"
    ;;
sentinel)
    out=$work/sentinel/$(date -u +%Y%m%dT%H%M%SZ); mkdir -p "$out"
    sentinel "$(machine)" "$out" && echo "$out/sentinel.json"
    ;;
run)
    start "$1"; shift
    echo "R $l (build $id) on $machine: run $run_id on CPU $bench_cpus, kernel $(uname -r)"

    rc=0; sentinel "$machine" "$out" || rc=$?
    if [ "$rc" = 3 ]; then
        echo "sentinel failed: not running the timing pass on $(hostname -s)"
        if [ -n "${SLURM_JOB_ID:-}" ]; then   # keep the job, held, for when the box is fixed
            scontrol update jobid="$SLURM_JOB_ID" comment="sentinel failed on $(hostname -s)"
            scontrol requeuehold "$SLURM_JOB_ID"
        fi
        exit 1
    fi
    [ "$rc" = 0 ] || exit "$rc"

    # one pass of the suite per layout, one process per benchmark in each; the
    # passes' reports become one (timing.json), the k-th pass its process k.
    # An implementation without layouts runs its every pass as built; one with
    # a profile.R has it switch it on.
    impl=$(impl_of "$l"); bench_image=$(image_of "$l"); built=$(layouts_of "$l")
    switch=(); [ ! -f "$repo/impls/$impl/profile.R" ] || switch=(--profile "$repo/impls/$impl/profile.R")
    rc=0; k=0
    for pad in $layouts; do
        k=$((k + 1)); r=$work/r/$id/bin/R
        [ "$pad" = 0 ] || [ "$built" = 0 ] || r=$work/r/$id/layout/$pad/bin/R
        bench "run$k" timing "$r" --runs 1 --json "$out/timing-$k.json" --csv "$out/timing-$k.csv" \
            --dir "$out/exec-$k" "${switch[@]}" "$@" || rc=$?
    done
    "$repo/.venv/bin/speedr" merge-passes "$out"/timing-[0-9]*.json > "$out/timing.json" || rc=1
    {
        describe "$rc"; echo "layouts=$built"
        [ "$impl" = gnur ] || cat "$work/src/$l.env"   # impl, base, repo, ref, commit, commit_date
    } > "$out/run.env.new"
    to_spool
    exit $rc
    ;;
profile)
    start "$1"; shift
    # perf would see another implementation's generated code as unknown frames,
    # and the category rules know GNU R's interpreter only
    [ "$(impl_of "$l")" = gnur ] || { echo "the profile pass is for GNU R only, not $l"; exit 2; }
    echo "R $l (build $id) on $machine: profile $run_id on CPU $bench_cpus, kernel $(uname -r)"
    # the build as built (layout 0); then the recordings' category shares
    # (categories/categorize.R, on the housekeeping CPUs). Once reduced, the
    # recordings go; never copied to the spool, they stay if that failed.
    rc=0
    bench profile profile "$work/r/$id/bin/R" --json "$out/profile.json" --dir "$out/perf" "$@" || rc=$?
    if "$repo/.venv/bin/speedr" profile-manifest "$out/profile.json" "$out/perf" "$out/manifest.csv" &&
        docker run --rm --user "$(id -u):$(id -g)" -e HOME=/tmp --network none \
            --cpuset-cpus "$housekeeping_cpus" -v "$repo:$repo:ro" -v "$work:$work" "$profile_image" \
            Rscript "$repo/categories/categorize.R" --causes "$out/profile-causes.csv" \
            "$out/profile-shares.csv" "$out/manifest.csv"; then
        rm -rf "$out/perf" "$out/manifest.csv"
        # the quality gate: on average, at most 5% of a recording's samples unattributed
        u=$(awk -F, '$4 == "unattributed" { s += $7; n++ } END { printf "%.4f", n ? s / n : 1 }' \
            "$out/profile-shares.csv")
        echo "profile: unattributed share $u"
        awk -v u="$u" 'BEGIN { exit !(u <= 0.05) }' || { echo "profile: above 5%, not published"; rc=1; }
    else
        rc=1
    fi
    {
        describe "$rc"; echo "pass=profile"
        echo "perf=$(docker run --rm "$profile_image" perf --version)"
        echo "rules=$(sha256sum "$repo/categories/perf-rules.R" | cut -c1-12)"
    } > "$out/run.env.new"
    to_spool
    exit $rc
    ;;
*) echo "usage: $0 image | resolve|env|id|configure|build SOURCE | sentinel | run|profile SOURCE [driver args]" >&2; exit 2 ;;
esac
