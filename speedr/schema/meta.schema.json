{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/PRL-PRG/speedR/speedr/schema/meta.schema.json",
  "title": "speedR run metadata (meta.json)",
  "description": "Everything needed to interpret and reproduce one benchmarking session of one build on one machine. Stored next to the run's results in speedR-results.",
  "type": "object",
  "required": [
    "schema_version",
    "run_id",
    "methodology",
    "machine",
    "impl",
    "version",
    "kind",
    "config",
    "build",
    "suite",
    "run_design",
    "host",
    "started",
    "finished",
    "passes"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "run_id": {
      "type": "string",
      "pattern": "^[0-9]{8}T[0-9]{6}Z-[0-9a-f]{6}$"
    },
    "methodology": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+$",
      "description": "The methodology version the run was measured under (methodology/versions.csv); results of different versions are never compared"
    },
    "machine": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{1,38}[a-z0-9]$"
    },
    "impl": {
      "type": "string",
      "description": "gnur now; later rcp, rsh, fastr",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "version": {
      "type": "string",
      "description": "4.5.2 for a release, devel for R-devel",
      "pattern": "^([0-9]+\\.[0-9]+\\.[0-9]+|devel)$"
    },
    "kind": {
      "enum": [
        "release",
        "devel"
      ]
    },
    "svn_rev": {
      "type": [
        "integer",
        "null"
      ],
      "description": "R's SVN revision (R-devel and releases alike)"
    },
    "base_gnur_version": {
      "type": [
        "string",
        "null"
      ],
      "description": "For other implementations: the GNU R they derive from"
    },
    "config": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]*$"
    },
    "build": {
      "type": "object",
      "required": [
        "id",
        "source",
        "flags",
        "toolchain"
      ],
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[0-9a-f]{16}$"
        },
        "source": {
          "type": "string",
          "description": "tarball sha256, or r<rev> for R-devel"
        },
        "flags": {
          "type": "object",
          "additionalProperties": {
            "type": "string"
          }
        },
        "toolchain": {
          "type": "string",
          "description": "build image digest (Linux) or toolchain manifest hash"
        },
        "blas": {
          "type": "string"
        },
        "cached": {
          "type": "boolean"
        },
        "source_date": {
          "type": "string",
          "format": "date",
          "description": "date of the R source (SVN Last Changed Date)"
        }
      }
    },
    "suite": {
      "type": "object",
      "required": [
        "repo",
        "commit",
        "bench_commit"
      ],
      "additionalProperties": false,
      "properties": {
        "repo": {
          "type": "string"
        },
        "commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "r-benchmarks commit (the rbench package in speedR's uv.lock)"
        },
        "bench_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "bench commit (pinned by rbench, recorded in speedR's uv.lock)"
        },
        "benchmarks": {
          "type": "integer",
          "minimum": 0
        },
        "unsupported": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "speedr_commit": {
          "type": "string",
          "pattern": "^[0-9a-f]{40}$",
          "description": "speedR commit that ran it"
        }
      }
    },
    "run_design": {
      "type": "object",
      "required": [
        "runs",
        "iterations",
        "warmups"
      ],
      "additionalProperties": false,
      "properties": {
        "runs": {
          "type": "integer",
          "minimum": 1
        },
        "iterations": {
          "type": "integer",
          "minimum": 1
        },
        "warmups": {
          "type": "integer",
          "minimum": 0
        },
        "seed": {
          "type": "integer"
        },
        "cpuset": {
          "type": "string"
        },
        "aslr": {
          "type": "boolean"
        }
      }
    },
    "host": {
      "type": "object",
      "required": [
        "kernel"
      ],
      "properties": {
        "kernel": {
          "type": "string"
        },
        "cmdline": {
          "type": "string"
        },
        "os_release": {
          "type": "string"
        },
        "boot_id": {
          "type": "string"
        },
        "uptime_s": {
          "type": "number",
          "minimum": 0
        },
        "wake": {
          "enum": [
            "wol",
            "ipmi",
            "relay",
            "always-on",
            "manual",
            "none"
          ]
        },
        "doctor": {
          "type": "object",
          "required": [
            "passed"
          ],
          "properties": {
            "passed": {
              "type": "boolean"
            },
            "report": {}
          }
        },
        "node": {
          "type": "string",
          "description": "the box of the machine (cluster) that ran it"
        },
        "slurm_job": {
          "type": "string"
        },
        "fingerprint": {
          "type": "object",
          "description": "bench's fingerprint of the system"
        },
        "probe": {
          "type": "object",
          "required": [
            "status"
          ],
          "description": "the node's native probe before the job (prlprg-bench prolog)",
          "properties": {
            "status": {
              "enum": [
                "ok",
                "suspect",
                "failed",
                "uncalibrated"
              ]
            },
            "deviation": {
              "type": "number"
            },
            "values": {
              "type": "object"
            },
            "reference": {
              "type": "object"
            },
            "node": {
              "type": "string"
            }
          }
        }
      }
    },
    "sentinel": {
      "type": "object",
      "required": [
        "version",
        "times_ms",
        "status"
      ],
      "additionalProperties": false,
      "description": "the sentinel before the timing pass (speedr/sentinel.py)",
      "properties": {
        "version": {
          "type": "string"
        },
        "times_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "reference_ms": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "exclusiveMinimum": 0
          }
        },
        "deviation": {
          "type": [
            "number",
            "null"
          ],
          "description": "geometric mean of time / reference, minus 1"
        },
        "status": {
          "enum": [
            "ok",
            "suspect",
            "failed",
            "uncalibrated"
          ]
        },
        "error": {
          "type": "string"
        }
      }
    },
    "started": {
      "type": "string",
      "format": "date-time"
    },
    "finished": {
      "type": "string",
      "format": "date-time"
    },
    "passes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "enum": [
          "timing",
          "profile"
        ]
      },
      "uniqueItems": true
    },
    "profile": {
      "type": "object",
      "required": [
        "profiler",
        "rules_version"
      ],
      "additionalProperties": false,
      "properties": {
        "profiler": {
          "enum": [
            "perf",
            "samply",
            "xctrace",
            "etw"
          ]
        },
        "rules_version": {
          "type": "string"
        },
        "frequency_hz": {
          "type": "integer"
        },
        "call_graph": {
          "type": "string"
        },
        "recordings": {
          "type": "integer",
          "minimum": 1
        },
        "unattributed_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "workflow": {
      "type": "object",
      "description": "The GitHub Actions run that produced this",
      "properties": {
        "repository": {
          "type": "string"
        },
        "run_id": {
          "type": "integer"
        },
        "sha": {
          "type": "string"
        }
      }
    }
  }
}
